---
import { hours, site } from "../data/site";
---

<section
	id="hours"
	aria-labelledby="hours-title"
	class="slice-top-r scroll-mt-24 bg-sand-100 py-20 [--slice:2.5rem] sm:py-28 lg:[--slice:5rem] dark:bg-sand-900/50"
>
	<div class="mx-auto max-w-6xl px-4 sm:px-6">
		<header class="max-w-2xl">
			<p class="flex items-center gap-3 font-medium text-clay-600 dark:text-clay-300">
				<span class="blade h-3 w-12 shrink-0" aria-hidden="true"></span>
				שעות ומיקום
			</p>
			<h2
				id="hours-title"
				class="mt-3 font-display text-4xl font-black text-olive-950 sm:text-5xl dark:text-sand-50"
			>
				מתי ואיפה
			</h2>
			<p class="mt-4 text-lg text-sand-700 dark:text-sand-300">
				אפשר גם בלי תור מראש, אבל עם תור לא מחכים.
			</p>
		</header>

		<div class="mt-14 grid gap-8 lg:grid-cols-2">
			{/* שעות פעילות */}
			<div
				class="slice-tl border-2 border-sand-300 bg-sand-50 p-6 [--slice:2rem] sm:p-8 dark:border-sand-800 dark:bg-sand-950"
			>
				<div class="flex flex-wrap items-center gap-3">
					<h3 class="font-display text-2xl font-black text-olive-950 dark:text-sand-50">שעות פעילות</h3>
					<p
						data-open-badge
						hidden
						class="slice-br flex items-center gap-2 bg-sand-200 px-3.5 py-1.5 text-sm font-bold text-sand-900 [--slice:0.6rem] [[hidden]]:hidden dark:bg-sand-800 dark:text-sand-100"
					>
					</p>
				</div>

				<table class="mt-6 w-full text-start">
					<caption class="sr-only">שעות הפעילות של המספרה לפי ימי השבוע</caption>
					<thead class="sr-only">
						<tr>
							<th scope="col">יום</th>
							<th scope="col">שעות</th>
						</tr>
					</thead>
					<tbody>
						{
							hours.map((day, index) => (
								<tr
									data-day-row={index}
									class="border-b border-dashed border-sand-300 last:border-0 dark:border-sand-800"
								>
									<th
										scope="row"
										class="py-3.5 text-start font-medium text-sand-800 dark:text-sand-200"
									>
										{day.label}
										<span
											data-today-marker
											hidden
											class="slice-br ms-2 bg-olive-200 px-2.5 py-0.5 text-xs font-bold text-olive-900 [--slice:0.45rem] dark:bg-olive-800 dark:text-olive-100"
										>
											היום
										</span>
									</th>
									<td class="py-3.5 text-end tabular-nums text-sand-700 dark:text-sand-300">
										{day.open ? <bdi>{day.open}–{day.close}</bdi> : (day.note ?? "סגור")}
									</td>
								</tr>
							))
						}
					</tbody>
				</table>

				<p class="mt-6 text-sm text-sand-600 dark:text-sand-400">
					בערבי חג ובחגים ייתכנו שינויים — מתעדכנים באינסטגרם.
				</p>
			</div>

			{/* מיקום */}
			<div
				class="slice-tr border-2 border-sand-300 bg-sand-50 p-6 [--slice:2rem] sm:p-8 dark:border-sand-800 dark:bg-sand-950"
			>
				<h3 class="font-display text-2xl font-black text-olive-950 dark:text-sand-50">איפה אנחנו</h3>

				<address class="mt-4 space-y-3 text-base not-italic text-sand-700 dark:text-sand-300">
					<p class="flex items-start gap-3">
						<svg
							class="mt-0.5 size-5 shrink-0 text-clay-600 dark:text-clay-400"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="1.8"
							aria-hidden="true"
						>
							<path d="M12 21s7-5.5 7-11a7 7 0 1 0-14 0c0 5.5 7 11 7 11Z"></path>
							<circle cx="12" cy="10" r="2.6"></circle>
						</svg>
						<span>{site.address.full}<br />חניה חופשית ברחוב הסמוך</span>
					</p>
					<p class="flex items-center gap-3">
						<svg
							class="size-5 shrink-0 text-clay-600 dark:text-clay-400"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="1.8"
							aria-hidden="true"
						>
							<path
								d="M5 4h3l2 5-2.2 1.4a12 12 0 0 0 5.8 5.8L15 14l5 2v3a2 2 0 0 1-2.2 2A16 16 0 0 1 3 6.2 2 2 0 0 1 5 4Z"
							></path>
						</svg>
						<a
							href={site.phoneHref}
							class="font-medium text-olive-800 underline underline-offset-4 hover:text-olive-600 dark:text-olive-300 dark:hover:text-olive-200"
							>{site.phoneDisplay}</a
						>
					</p>
				</address>

				<div class="mt-6 flex flex-wrap gap-3">
					<a
						href={site.address.waze}
						target="_blank"
						rel="noopener noreferrer"
						class="bg-olive-700 px-6 py-3 text-sm font-bold text-sand-50 transition hover:bg-olive-800 dark:bg-olive-500 dark:text-olive-950 dark:hover:bg-olive-400"
					>
						ניווט ב-Waze<span class="sr-only"> (נפתח בחלון חדש)</span>
					</a>
					<a
						href={site.address.maps}
						target="_blank"
						rel="noopener noreferrer"
						class="border-2 border-clay-500 px-6 py-3 text-sm font-bold text-clay-800 transition hover:bg-clay-500 hover:text-sand-50 dark:border-clay-400 dark:text-clay-200 dark:hover:bg-clay-400 dark:hover:text-clay-950"
					>
						פתיחה ב-Google Maps<span class="sr-only"> (נפתח בחלון חדש)</span>
					</a>
				</div>

				{/* המפה עצמה לא ניתנת לחיתוך — החיתוך על העטיפה */}
				<div class="slice-bot-l mt-6 overflow-hidden [--slice:1.75rem]">
					<iframe
						src={site.address.embed}
						title={`מפה: ${site.address.full}`}
						loading="lazy"
						referrerpolicy="no-referrer-when-downgrade"
						class="h-64 w-full border-0 grayscale-25"></iframe>
				</div>
			</div>
		</div>
	</div>
</section>

<script is:inline define:vars={{ hours }}>
	// כל החישובים לפי שעון ישראל, גם אם הגולש נמצא באזור זמן אחר
	const formatter = new Intl.DateTimeFormat("en-US", {
		timeZone: "Asia/Jerusalem",
		weekday: "short",
		hour: "2-digit",
		minute: "2-digit",
		hourCycle: "h23",
	});

	const days = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
	const parts = Object.fromEntries(formatter.formatToParts(new Date()).map((p) => [p.type, p.value]));
	const today = days.indexOf(parts.weekday);
	const minutesNow = Number(parts.hour) * 60 + Number(parts.minute);
	const toMinutes = (time) => {
		const [h, m] = time.split(":").map(Number);
		return h * 60 + m;
	};

	if (today >= 0) {
		const row = document.querySelector(`[data-day-row="${today}"]`);
		if (row) {
			row.querySelector("th")?.setAttribute("aria-current", "date");
			row.classList.add("font-bold", "text-olive-900", "dark:text-olive-200");
			const marker = row.querySelector("[data-today-marker]");
			if (marker) marker.hidden = false;
		}

		const day = hours[today];
		const isOpen =
			!!day.open && minutesNow >= toMinutes(day.open) && minutesNow < toMinutes(day.close);

		let message;
		if (isOpen) {
			message = `פתוח עכשיו · עד ${day.close}`;
		} else if (day.open && minutesNow < toMinutes(day.open)) {
			message = `סגור · נפתח היום ב-${day.open}`;
		} else {
			let next = null;
			for (let i = 1; i <= 7; i++) {
				const candidate = hours[(today + i) % 7];
				if (candidate.open) {
					next = { day: candidate, offset: i };
					break;
				}
			}
			message = next
				? `סגור · נפתח ${next.offset === 1 ? "מחר" : `ביום ${next.day.label}`} ב-${next.day.open}`
				: "סגור";
		}

		document.querySelectorAll("[data-open-badge]").forEach((badge) => {
			badge.textContent = "";
			const dot = document.createElement("span");
			dot.className = `size-2.5 shrink-0 ${isOpen ? "bg-olive-600" : "bg-clay-600"}`;
			dot.setAttribute("aria-hidden", "true");
			badge.append(dot, document.createTextNode(message));
			badge.hidden = false;
		});
	}
</script>

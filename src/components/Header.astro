---
import { nav, site } from "../data/site";
import ThemeToggle from "./ThemeToggle.astro";

const pill =
	"inline-flex items-center justify-center rounded-full px-5 py-2.5 text-sm font-bold whitespace-nowrap transition focus-visible:-outline-offset-3";
---

<header class="bg-ink text-sand-100 pb-2">
	<div>
		<div class="flex items-center gap-3 py-3 px-4 sm:px-8 lg:px-12">
			<a
				href="#top"
				class="shrink-0 rounded-lg"
				aria-label={`${site.name} — לראש הדף`}
			>
				<img
					src="/images/banner.jpeg"
					alt=""
					width="484"
					height="262"
					class="h-11 w-auto sm:h-42"
				/>
			</a>

			<div class="ms-auto flex items-center gap-2 sm:gap-3">
				<a
					href={site.bookingUrl}
					class={`${pill} bg-olive-500 text-olive-950 hover:bg-olive-400`}
				>
					הזמן תור אונליין
				</a>

				<a
					href={site.whatsapp}
					class={`${pill} hidden border-2 border-sand-100/60 text-sand-50 hover:bg-sand-50/10 md:inline-flex`}
				>
					דבר איתנו בוואטסאפ
				</a>

				<a
					href={site.address.waze}
					class={`${pill} hidden bg-sand-100 text-sand-900 hover:bg-sand-50 md:inline-flex`}
				>
					נווט אלינו
				</a>

				<ThemeToggle class="rounded-full" />

				<button
					type="button"
					data-menu-button
					aria-expanded="false"
					aria-controls="mobile-menu"
					class="inline-grid size-11 place-items-center rounded-full border-2 border-sand-100/25 text-sand-100 transition hover:bg-sand-50/10 md:hidden"
				>
					<span class="sr-only">פתיחת תפריט הניווט</span>
					<svg
						class="size-5"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="1.9"
						stroke-linecap="round"
						aria-hidden="true"
					>
						<path d="M4 7h16M4 12h16M4 17h16"></path>
					</svg>
				</button>
			</div>
		</div>

		<nav
			aria-label="ניווט ראשי"
			class="hidden border-t border-sand-100/15 md:block px-4 sm:px-8 lg:px-12"
		>
			<ul class="flex items-center gap-6 py-2.5">
				{
					nav.map((item) => (
						<li>
							<a
								href={item.href}
								class="block text-lg font-bold text-sand-200 transition hover:text-olive-200"
							>
								{item.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
	</div>

	<nav
		id="mobile-menu"
		aria-label="ניווט ראשי (נייד)"
		hidden
		class="border-t border-sand-100/15 bg-ink md:hidden"
	>
		<ul class="px-4 py-3 sm:px-8">
			{
				nav.map((item) => (
					<li>
						<a
							href={item.href}
							class="block border-s-4 border-transparent px-4 py-3 text-base font-medium text-sand-100 transition hover:border-olive-400 hover:bg-sand-50/10"
						>
							{item.label}
						</a>
					</li>
				))
			}
			<li class="pt-2">
				<a
					href={site.whatsapp}
					class="block rounded-full border-2 border-sand-100/60 px-3 py-3 text-center text-base font-bold text-sand-50"
				>
					דבר איתנו בוואטסאפ
				</a>
			</li>
			<li class="pt-2">
				<a
					href={site.address.waze}
					class="block rounded-full bg-sand-100 px-3 py-3 text-center text-base font-bold text-sand-900"
				>
					נווט אלינו
				</a>
			</li>
		</ul>
	</nav>
</header>

<script>
	const button =
		document.querySelector<HTMLButtonElement>("[data-menu-button]");
	const menu = document.querySelector<HTMLElement>("#mobile-menu");

	if (button && menu) {
		const setOpen = (open: boolean) => {
			button.setAttribute("aria-expanded", String(open));
			menu.hidden = !open;
			const label = button.querySelector(".sr-only");
			if (label)
				label.textContent = open
					? "סגירת תפריט הניווט"
					: "פתיחת תפריט הניווט";
		};

		button.addEventListener("click", () => {
			setOpen(button.getAttribute("aria-expanded") !== "true");
		});

		// סגירה אחרי בחירת קישור, ובלחיצה על Escape
		menu.addEventListener("click", (e) => {
			if ((e.target as HTMLElement).closest("a")) setOpen(false);
		});

		document.addEventListener("keydown", (e) => {
			if (
				e.key === "Escape" &&
				button.getAttribute("aria-expanded") === "true"
			) {
				setOpen(false);
				button.focus();
			}
		});
	}
</script>

---
import { site } from "../data/site";
import Logo from "./Logo.astro";

/* מוצגות רק הרשתות שקיימות ב-data/site.ts — מי שמסומן בהערה פשוט לא מרונדר */
const social: Record<string, string | undefined> = site.social;
const iconClass =
	"inline-grid size-11 place-items-center border-2 border-sand-300 text-sand-700 transition hover:border-olive-600 hover:bg-olive-100 hover:text-olive-900 dark:border-sand-800 dark:text-sand-300 dark:hover:border-olive-400 dark:hover:bg-olive-900/40 dark:hover:text-olive-100";

const year = new Date().getFullYear();
---

<footer
	class="slice-top-l border-t-2 border-sand-300 bg-sand-50 [--slice:2rem] lg:[--slice:4rem] dark:border-sand-800 dark:bg-sand-950"
>
	<div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:pt-20">
		<div class="flex flex-col gap-8 sm:flex-row sm:items-center">
			<div>
				<p class="flex items-center gap-2.5 text-olive-800 dark:text-olive-200">
					<Logo class="size-6" />
					<span class="font-display text-xl font-black">{site.name}</span>
				</p>
				<p class="mt-2 text-sm text-sand-600 dark:text-sand-400">
					{site.address.full} · <a
						href={site.phoneHref}
						class="underline underline-offset-4 hover:text-olive-700 dark:hover:text-olive-300"
						>{site.phoneDisplay}</a
					>
				</p>
			</div>

			<nav aria-label="רשתות חברתיות" class="sm:ms-auto">
				<ul class="flex flex-wrap items-center gap-2">
					{
						social.instagram && (
							<li>
								<a href={social.instagram} target="_blank" rel="noopener noreferrer" class={iconClass}>
									<span class="sr-only">אינסטגרם (נפתח בחלון חדש)</span>
									<svg
										class="size-5"
										viewBox="0 0 24 24"
										fill="none"
										stroke="currentColor"
										stroke-width="1.8"
										aria-hidden="true"
									>
										<rect x="3" y="3" width="18" height="18" rx="5" />
										<circle cx="12" cy="12" r="4" />
										<circle cx="17.5" cy="6.5" r="1.1" fill="currentColor" stroke="none" />
									</svg>
								</a>
							</li>
						)
					}
					{
						social.facebook && (
							<li>
								<a href={social.facebook} target="_blank" rel="noopener noreferrer" class={iconClass}>
									<span class="sr-only">פייסבוק (נפתח בחלון חדש)</span>
									<svg
										class="size-5"
										viewBox="0 0 24 24"
										fill="none"
										stroke="currentColor"
										stroke-width="1.8"
										aria-hidden="true"
									>
										<path d="M14.5 21v-8h2.7l.5-3.2h-3.2V7.7c0-.9.3-1.6 1.7-1.6h1.6V3.2c-.8-.1-1.7-.2-2.6-.2-2.6 0-4.3 1.6-4.3 4.4v2.4H8v3.2h2.9V21" />
									</svg>
								</a>
							</li>
						)
					}
					{
						social.tiktok && (
							<li>
								<a href={social.tiktok} target="_blank" rel="noopener noreferrer" class={iconClass}>
									<span class="sr-only">טיקטוק (נפתח בחלון חדש)</span>
									<svg
										class="size-5"
										viewBox="0 0 24 24"
										fill="none"
										stroke="currentColor"
										stroke-width="1.8"
										stroke-linejoin="round"
										aria-hidden="true"
									>
										<path d="M14.5 3v11.4a3.4 3.4 0 1 1-2.8-3.35" />
										<path d="M14.5 3c.4 2.6 2 4.2 4.6 4.5" />
									</svg>
								</a>
							</li>
						)
					}
					<li>
						<a
							href={site.whatsapp}
							target="_blank"
							rel="noopener noreferrer"
							class="slice-br ms-1 bg-olive-700 px-6 py-3 text-sm font-bold text-sand-50 transition [--slice:0.75rem] hover:bg-olive-800 focus-visible:-outline-offset-3 dark:bg-olive-500 dark:text-olive-950 dark:hover:bg-olive-400"
						>
							וואטסאפ<span class="sr-only"> — קביעת תור (נפתח בחלון חדש)</span>
						</a>
					</li>
				</ul>
			</nav>
		</div>

		<p
			class="mt-10 border-t-2 border-sand-300 pt-6 text-sm text-sand-600 dark:border-sand-800 dark:text-sand-400"
		>
			© {year} {site.name}. כל הזכויות שמורות.
		</p>
	</div>
</footer>

---
import { barbers } from "../data/site";
---

<section
	aria-labelledby="barbers-title"
	class="scroll-mt-24 overflow-hidden py-20 sm:py-28"
>
	<div class="mx-auto max-w-6xl px-4 sm:px-6" id="barbers">
		<header class="max-w-2xl">
			<p
				class="flex items-center gap-3 font-medium text-clay-600 dark:text-clay-300"
			>
				<span class="blade h-3 w-12 shrink-0" aria-hidden="true"></span>
				צוות המספרה
			</p>
			<h2
				id="barbers-title"
				class="mt-3 font-display text-4xl font-black text-olive-950 sm:text-5xl dark:text-sand-50"
			>
				תפגשו את הצוות
			</h2>
			<p class="mt-4 text-lg text-sand-700 dark:text-sand-300">
				כל אחד עם היד שלו. אפשר לבחור מי יטפל בכם כשקובעים תור.
			</p>
		</header>
	</div>

	<ol role="list" class="mt-14 space-y-16 lg:mt-20 lg:space-y-0">
		{
			barbers.map((barber, index) => {
				const imageOnStart = index % 2 === 0;
				return (
					<li class="group relative">
						{/* גובה השורה נקבע ע"י עמודת הטקסט: התמונה יוצאת מהזרימה ב-lg (absolute)
						    ולכן לא תורמת לגובה, ורק נמתחת למלא את מה שהטקסט קבע */}
						<div class="grid lg:grid-cols-2 lg:items-stretch">
							{/* עמודת התמונה */}
							<div
								class={`relative ${imageOnStart ? "" : "lg:order-last"}`}
							>
								{/* בלוק צבע מוסט מאחורי התמונה — נותן עומק לחיתוך */}
								<div
									aria-hidden="true"
									class={`absolute inset-0 hidden bg-olive-700/25 lg:block dark:bg-olive-500/20 ${
										imageOnStart
											? "lg:slice-bl lg:-translate-x-6 lg:[--slice:7rem]"
											: "lg:slice-br lg:translate-x-6 lg:[--slice:7rem]"
									}`}
								/>
								<img
									src={barber.image}
									alt={`${barber.name}, ${barber.role} ב"היצירה"`}
									loading="lazy"
									decoding="async"
									class={`slice-bot-l relative w-full object-cover object-center grayscale transition-[filter] duration-500 ease-out group-hover:grayscale-0 [--slice:2rem] [@media(hover:none)]:grayscale-0 lg:absolute lg:inset-0 lg:h-full lg:[--slice:7rem] ${
										imageOnStart
											? "lg:slice-bl"
											: "lg:slice-br"
									}`}
								/>
								{/* מספר סידורי דקורטיבי בתפר */}
								<span
									aria-hidden="true"
									class={`absolute bottom-2 font-display text-7xl leading-none font-black text-sand-50/70 mix-blend-overlay lg:bottom-6 lg:text-[9rem] dark:text-sand-950/60 ${
										/* בנייד החיתוך תמיד בפינה התחתונה בצד הסיום, ולכן המספר נשאר בצד ההתחלה */
										imageOnStart
											? "inset-s-4 lg:inset-s-10"
											: "inset-s-4 lg:inset-s-auto lg:inset-e-10"
									}`}
								>
									{String(index + 1).padStart(2, "0")}
								</span>
							</div>

							{/* עמודת הטקסט */}
							<div
								class={`flex flex-col justify-center px-4 pt-8 sm:px-6 lg:px-14 lg:py-16 ${
									imageOnStart
										? "lg:pe-6 lg:ps-14"
										: "lg:pe-14 lg:ps-6"
								}`}
							>
								<div
									class={`w-full max-w-xl ${imageOnStart ? "lg:me-auto" : "lg:ms-auto"}`}
								>
									<p class="font-medium text-clay-700 dark:text-clay-300">
										{barber.role}
									</p>
									<h3 class="mt-1 font-display text-3xl font-black text-olive-950 sm:text-4xl dark:text-sand-50">
										{barber.name}
									</h3>

									<span
										aria-hidden="true"
										class="mt-5 block h-1 w-20 bg-clay-500 dark:bg-clay-400"
									/>

									<p class="mt-5 text-lg leading-relaxed text-sand-700 dark:text-sand-300">
										{barber.bio}
									</p>

									<ul
										role="list"
										class="mt-6 flex flex-wrap gap-2"
										aria-label={`התמחויות של ${barber.name}`}
									>
										{barber.specialties.map((item) => (
											<li class="slice-br bg-olive-100 px-4 py-1.5 text-sm font-medium text-olive-900 [--slice:0.7rem] dark:bg-olive-900/60 dark:text-olive-100">
												{item}
											</li>
										))}
									</ul>

									<p class="mt-7 flex flex-wrap items-center gap-x-5 gap-y-3 border-t-2 border-sand-200 pt-5 text-sm text-sand-600 dark:border-sand-800 dark:text-sand-400">
										<span>{barber.years} שנות ניסיון</span>
										{barber.instagram && (
											<a
												href={barber.instagram}
												rel="noopener noreferrer"
												target="_blank"
												class="inline-flex items-center gap-1.5 font-bold text-olive-800 underline-offset-4 hover:underline dark:text-olive-300"
											>
												<svg
													class="size-4"
													viewBox="0 0 24 24"
													fill="none"
													stroke="currentColor"
													stroke-width="1.8"
													aria-hidden="true"
												>
													<rect
														x="3"
														y="3"
														width="18"
														height="18"
														rx="5"
													/>
													<circle
														cx="12"
														cy="12"
														r="4"
													/>
													<circle
														cx="17.5"
														cy="6.5"
														r="1.1"
														fill="currentColor"
														stroke="none"
													/>
												</svg>
												<span>
													אינסטגרם
													<span class="sr-only">
														{" "}
														של {barber.name} (נפתח
														בחלון חדש)
													</span>
												</span>
											</a>
										)}
									</p>
								</div>
							</div>
						</div>
					</li>
				);
			})
		}
	</ol>
</section>

---
import { barbers, priceFor, services, site } from "../data/site";

const panelId = (id: string) => `pricing-panel-${id}`;
const tabId = (id: string) => `pricing-tab-${id}`;
---

<section aria-labelledby="pricing-title" class="scroll-mt-24 py-20 sm:py-28">
	<div class="mx-auto max-w-6xl px-4 sm:px-6" id="pricing">
		<header class="max-w-2xl" data-reveal-stagger="90">
			<p
				class="flex items-center gap-3 font-medium text-clay-600 dark:text-clay-300"
				data-reveal
			>
				<span class="blade h-3 w-12 shrink-0" aria-hidden="true"></span>
				מחירון
			</p>
			<h2
				id="pricing-title"
				class="mt-3 font-display text-4xl font-black text-olive-950 sm:text-5xl dark:text-sand-50"
				data-reveal
			>
				כמה כל התענוג יוצא?
			</h2>
			<p class="mt-4 text-lg text-sand-700 dark:text-sand-300" data-reveal>
				לכל אחד מהצוות המחירון שלו. בחרו ספר כדי לראות את המחירים שלו.
			</p>
		</header>

		<div class="relative mt-14" data-reveal>
			<div
				aria-hidden="true"
				class="notch absolute inset-0 hidden translate-x-3 translate-y-3 bg-olive-700/15 [--notch:2.5rem] sm:block dark:bg-olive-400/15"
			>
			</div>

			<div
				class="notch relative border-2 border-sand-300 bg-sand-50 p-6 [--notch:2.5rem] sm:p-10 dark:border-sand-800 dark:bg-sand-950"
			>
				{/* בלי JS אלה קישורי דילוג והמחירונים כולם גלויים; הסקריפט מטה
				    הופך אותם ללשוניות אמיתיות. ראו את ההערה בסקריפט. */}
				<div
					class="flex flex-wrap gap-2 border-b-2 border-sand-300 pb-4 sm:gap-3 dark:border-sand-800"
					data-pricing-tabs
				>
					{
						barbers.map((barber) => (
							<a
								href={`#${panelId(barber.id)}`}
								id={tabId(barber.id)}
								data-pricing-tab={barber.id}
								class="group flex items-center gap-2.5 border-2 border-sand-300 bg-sand-100 py-2 pe-4 ps-2 font-display font-bold text-sand-700 transition aria-selected:border-olive-700 aria-selected:bg-olive-700 aria-selected:text-sand-50 hover:border-sand-400 hover:bg-sand-200 aria-selected:hover:bg-olive-700 sm:text-lg dark:border-sand-700 dark:bg-sand-900 dark:text-sand-300 dark:aria-selected:border-olive-400 dark:aria-selected:bg-olive-500 dark:aria-selected:text-olive-950 dark:hover:bg-sand-800 dark:aria-selected:hover:bg-olive-500"
							>
								<img
									src={barber.image}
									alt=""
									loading="lazy"
									decoding="async"
									class="size-9 shrink-0 object-cover object-center grayscale transition group-aria-selected:grayscale-0"
								/>
								<span>{barber.shortName}</span>
								{/* סימון נוסף מעבר לצבע, למי שלא מבחין בו */}
								<svg
									class="size-4 shrink-0 opacity-0 transition group-aria-selected:opacity-100"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="3"
									stroke-linecap="square"
									aria-hidden="true"
								>
									<path d="m5 13 4.5 4.5L19 7" />
								</svg>
							</a>
						))
					}
				</div>

				{
					barbers.map((barber) => (
						<div
							id={panelId(barber.id)}
							aria-labelledby={tabId(barber.id)}
							data-pricing-panel={barber.id}
							class="scroll-mt-24 pt-8"
						>
							{/* הכותרת היא העוגן נגד בלבול: תמיד כתוב במפורש
							    מחירון של מי מוצג כרגע */}
							<h3 class="flex items-center gap-4">
								<span
									aria-hidden="true"
									class="h-10 w-1.5 shrink-0 bg-clay-500 dark:bg-clay-400"
								/>
								<span>
									<span class="block font-display text-2xl font-black text-olive-950 sm:text-3xl dark:text-sand-50">
										המחירון של {barber.name}
									</span>
									<span class="mt-0.5 block text-sm font-medium text-clay-700 dark:text-clay-300">
										{barber.role}
									</span>
								</span>
							</h3>

							<ul role="list" class="mt-6 grid gap-x-14 md:grid-cols-2">
								{services.map((service) => (
									<li class="flex items-baseline gap-3 border-b border-dashed border-sand-300 py-4 last:border-0 dark:border-sand-800">
										<span
											aria-hidden="true"
											class={`mt-1 h-10 w-1 shrink-0 self-start ${
												service.popular
													? "bg-clay-500 dark:bg-clay-400"
													: "bg-sand-300 dark:bg-sand-800"
											}`}
										/>
										<div class="min-w-0">
											<h4 class="flex flex-wrap items-center gap-2 font-display text-xl font-bold text-olive-950 dark:text-sand-50">
												{service.name}
												{service.popular && (
													<span class="slice-br bg-clay-200 px-2.5 py-0.5 text-xs font-bold text-clay-900 [--slice:0.5rem] dark:bg-clay-800 dark:text-clay-100">
														מבוקש
													</span>
												)}
											</h4>
											<p class="mt-1 text-sm text-sand-600 dark:text-sand-400">
												{service.desc} · כ-
												{service.minutes} דקות
											</p>
										</div>
										<span
											class="leader h-3 flex-1 text-sand-400 dark:text-sand-700"
											aria-hidden="true"
										/>
										<p class="shrink-0 font-display text-2xl font-black text-olive-800 dark:text-olive-300">
											<span class="sr-only">
												מחיר אצל {barber.shortName}:{" "}
											</span>
											<bdi>{priceFor(service, barber)} ₪</bdi>
										</p>
									</li>
								))}
							</ul>
						</div>
					))
				}

				<div
					class="mt-8 flex flex-col items-start gap-4 border-t-2 border-sand-300 pt-8 sm:flex-row sm:items-center dark:border-sand-800"
				>
					<p class="text-sand-700 dark:text-sand-300">
						חיילים וסטודנטים — 10% הנחה בהצגת תעודה. ביטול תור עד
						שעתיים מראש.
					</p>
					<a
						href={site.bookingUrl}
						class="shrink-0 bg-olive-700 px-7 py-3.5 font-bold text-sand-50 transition hover:bg-olive-800 sm:ms-auto dark:bg-olive-500 dark:text-olive-950 dark:hover:bg-olive-400"
					>
						קביעת תור
					</a>
				</div>
			</div>
		</div>
	</div>
</section>

<script>
	// לשוניות המחירון — שיפור הדרגתי.
	//
	// ב-HTML אלה קישורים רגילים לעוגנים, וכל המחירונים גלויים זה אחר זה.
	// כך זה עובד גם בלי JS. הסקריפט הוא שמוסיף את תפקידי ה-ARIA של
	// לשוניות ומסתיר את הפאנלים שאינם פעילים — ולכן התפקידים מוכרזים
	// רק כשההתנהגות שמאחוריהם באמת קיימת.
	const list = document.querySelector<HTMLElement>("[data-pricing-tabs]");
	const tabs = [
		...(list?.querySelectorAll<HTMLAnchorElement>("[data-pricing-tab]") ?? []),
	];
	const panels = tabs.map((tab) =>
		document.querySelector<HTMLElement>(
			`[data-pricing-panel="${tab.dataset.pricingTab}"]`,
		),
	);

	if (list && tabs.length && panels.every(Boolean)) {
		list.setAttribute("role", "tablist");
		list.setAttribute("aria-label", "בחירת ספר לצפייה במחירון");

		tabs.forEach((tab, index) => {
			const panel = panels[index]!;
			tab.setAttribute("role", "tab");
			tab.setAttribute("aria-controls", panel.id);
			panel.setAttribute("role", "tabpanel");
			// הפאנל מקבל מיקוד כדי שאפשר יהיה לגלול בו במקלדת
			panel.tabIndex = 0;
		});

		let active = -1;

		const select = (index: number, moveFocus = false) => {
			if (index === active) return;
			active = index;

			tabs.forEach((tab, i) => {
				const chosen = i === index;
				tab.setAttribute("aria-selected", chosen ? "true" : "false");
				// roving tabindex: רק הלשונית הפעילה נמצאת במסלול הטאב
				tab.tabIndex = chosen ? 0 : -1;
				panels[i]!.hidden = !chosen;
			});

			if (moveFocus) tabs[index].focus();
		};

		// מאפשר להגיע ישירות למחירון של ספר מסוים דרך כתובת עם עוגן
		const fromHash = panels.findIndex(
			(panel) => panel!.id === location.hash.slice(1),
		);
		select(fromHash === -1 ? 0 : fromHash);

		// מכאן ההסתרה היא באחריות הסקריפט — מבטל את כלל המעבר שב-global.css
		document.documentElement.dataset.pricingReady = "";

		tabs.forEach((tab, index) => {
			tab.addEventListener("click", (event) => {
				// בלי זה הדפדפן היה קופץ לעוגן ומזיז את הדף באמצע הבחירה
				event.preventDefault();
				select(index);
			});
		});

		// הדף כולו RTL, ולכן "הבא" נמצא משמאל ו"הקודם" מימין
		const step: Record<string, number> = {
			ArrowLeft: 1,
			ArrowRight: -1,
			ArrowDown: 1,
			ArrowUp: -1,
		};

		list.addEventListener("keydown", (event) => {
			if (event.key === "Home" || event.key === "End") {
				event.preventDefault();
				return select(event.key === "Home" ? 0 : tabs.length - 1, true);
			}

			const move = step[event.key];
			if (move === undefined) return;
			event.preventDefault();
			select((active + move + tabs.length) % tabs.length, true);
		});
	}
</script>

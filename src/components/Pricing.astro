---
import { services, site } from "../data/site";
---

<section aria-labelledby="pricing-title" class="scroll-mt-24 py-20 sm:py-28">
	<div class="mx-auto max-w-6xl px-4 sm:px-6" id="pricing">
		<header class="max-w-2xl">
			<p
				class="flex items-center gap-3 font-medium text-clay-600 dark:text-clay-300"
			>
				<span class="blade h-3 w-12 shrink-0" aria-hidden="true"></span>
				מחירון
			</p>
			<h2
				id="pricing-title"
				class="mt-3 font-display text-4xl font-black text-olive-950 sm:text-5xl dark:text-sand-50"
			>
				מחירים בלי הפתעות
			</h2>
			<p class="mt-4 text-lg text-sand-700 dark:text-sand-300">
				המחיר שרשום הוא המחיר שמשלמים. תשלום במזומן, אשראי או ביט.
			</p>
		</header>

		<div class="relative mt-14">
			{/* שכבת צבע מוסטת מאחורי הלוח */}
			<div
				aria-hidden="true"
				class="notch absolute inset-0 hidden translate-x-3 translate-y-3 bg-olive-700/15 [--notch:2.5rem] sm:block dark:bg-olive-400/15"
			>
			</div>

			<div
				class="notch relative border-2 border-sand-300 bg-sand-50 p-6 [--notch:2.5rem] sm:p-10 dark:border-sand-800 dark:bg-sand-950"
			>
				<ul role="list" class="grid gap-x-14 md:grid-cols-2">
					{
						services.map((service) => (
							<li class="flex items-baseline gap-3 border-b border-dashed border-sand-300 py-4 last:border-0 dark:border-sand-800">
								<span
									aria-hidden="true"
									class={`mt-1 h-10 w-1 shrink-0 self-start ${
										service.popular
											? "bg-clay-500 dark:bg-clay-400"
											: "bg-sand-300 dark:bg-sand-800"
									}`}
								/>
								<div class="min-w-0">
									<h3 class="flex flex-wrap items-center gap-2 font-display text-xl font-bold text-olive-950 dark:text-sand-50">
										{service.name}
										{service.popular && (
											<span class="slice-br bg-clay-200 px-2.5 py-0.5 text-xs font-bold text-clay-900 [--slice:0.5rem] dark:bg-clay-800 dark:text-clay-100">
												מבוקש
											</span>
										)}
									</h3>
									<p class="mt-1 text-sm text-sand-600 dark:text-sand-400">
										{service.desc} · כ-{service.minutes}{" "}
										דקות
									</p>
								</div>
								<span
									class="leader h-3 flex-1 text-sand-400 dark:text-sand-700"
									aria-hidden="true"
								/>
								<p class="shrink-0 font-display text-2xl font-black text-olive-800 dark:text-olive-300">
									<span class="sr-only">מחיר: </span>
									<bdi>{service.price} ₪</bdi>
								</p>
							</li>
						))
					}
				</ul>

				<div
					class="mt-8 flex flex-col items-start gap-4 border-t-2 border-sand-300 pt-8 sm:flex-row sm:items-center dark:border-sand-800"
				>
					<p class="text-sand-700 dark:text-sand-300">
						חיילים וסטודנטים — 10% הנחה בהצגת תעודה. ביטול תור עד
						שעתיים מראש.
					</p>
					<a
						href={site.bookingUrl}
						class="shrink-0 bg-olive-700 px-7 py-3.5 font-bold text-sand-50 transition hover:bg-olive-800 sm:ms-auto dark:bg-olive-500 dark:text-olive-950 dark:hover:bg-olive-400"
					>
						קביעת תור
					</a>
				</div>
			</div>
		</div>
	</div>
</section>
